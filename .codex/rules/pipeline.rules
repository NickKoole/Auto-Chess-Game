prefix_rule(pattern = ["git", "push"], decision = "forbidden", justification = "Publish through automation/finish.mjs.")
prefix_rule(pattern = ["git", "remote"], decision = "forbidden")
prefix_rule(pattern = ["git", "reset", "--hard"], decision = "forbidden")
prefix_rule(pattern = ["git", "clean"], decision = "forbidden")
prefix_rule(pattern = ["gh", "pr", "review", "--approve"], decision = "forbidden", justification = "Only the human approves.")
prefix_rule(pattern = ["gh", "issue", "create"], decision = "allow")
prefix_rule(pattern = ["gh", "issue", "edit"], decision = "allow")
prefix_rule(pattern = ["gh", "issue", "close"], decision = "allow")
prefix_rule(pattern = ["gh", "issue", "comment"], decision = "allow")
prefix_rule(pattern = ["gh", "pr", "create"], decision = "forbidden")
prefix_rule(pattern = ["gh", "pr", "edit"], decision = "forbidden")
prefix_rule(pattern = ["gh", "pr", "close"], decision = "forbidden")
prefix_rule(pattern = ["gh", "pr", "merge"], decision = "forbidden")
prefix_rule(pattern = ["gh", "run", "rerun"], decision = "forbidden")
prefix_rule(pattern = ["gh", "workflow", "run"], decision = "forbidden")
prefix_rule(pattern = ["gh", "api"], decision = "forbidden")
