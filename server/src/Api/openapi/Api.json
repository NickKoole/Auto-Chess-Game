{
  "openapi": "3.1.1",
  "info": {
    "title": "Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Api"
        ],
        "operationId": "GetHealth",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/battles/matchups": {
      "get": {
        "tags": [
          "Api"
        ],
        "operationId": "ListMatchups",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MatchupDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/battles/units": {
      "get": {
        "tags": [
          "Api"
        ],
        "operationId": "ListUnits",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UnitDefinitionDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/battles/enemy-setups": {
      "get": {
        "tags": [
          "Api"
        ],
        "operationId": "ListEnemySetups",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EnemySetupDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/battles/simulate": {
      "post": {
        "tags": [
          "Api"
        ],
        "operationId": "SimulateBattle",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SimulateBattleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimulateBattleResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BattleEndingDto": {
        "type": "integer",
        "description": "Mirrors BattleEnding."
      },
      "BattleEventDto": {
        "required": [
          "type"
        ],
        "type": "object",
        "anyOf": [
          {
            "$ref": "#/components/schemas/BattleEventDtoUnitSpawnedEventDto"
          },
          {
            "$ref": "#/components/schemas/BattleEventDtoUnitMovedEventDto"
          },
          {
            "$ref": "#/components/schemas/BattleEventDtoUnitAttackedEventDto"
          },
          {
            "$ref": "#/components/schemas/BattleEventDtoDamageDealtEventDto"
          },
          {
            "$ref": "#/components/schemas/BattleEventDtoUnitDiedEventDto"
          }
        ],
        "description": "Mirrors BattleEvent's shape and discriminator.",
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "unitSpawned": "#/components/schemas/BattleEventDtoUnitSpawnedEventDto",
            "unitMoved": "#/components/schemas/BattleEventDtoUnitMovedEventDto",
            "unitAttacked": "#/components/schemas/BattleEventDtoUnitAttackedEventDto",
            "damageDealt": "#/components/schemas/BattleEventDtoDamageDealtEventDto",
            "unitDied": "#/components/schemas/BattleEventDtoUnitDiedEventDto"
          }
        }
      },
      "BattleEventDtoDamageDealtEventDto": {
        "required": [
          "attackerId",
          "targetId",
          "amount",
          "resultingHp",
          "tick"
        ],
        "properties": {
          "type": {
            "enum": [
              "damageDealt"
            ],
            "type": "string"
          },
          "attackerId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "targetId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "amount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "resultingHp": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "tick": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        },
        "description": "Mirrors DamageDealtEvent."
      },
      "BattleEventDtoUnitAttackedEventDto": {
        "required": [
          "attackerId",
          "targetId",
          "tick"
        ],
        "properties": {
          "type": {
            "enum": [
              "unitAttacked"
            ],
            "type": "string"
          },
          "attackerId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "targetId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "tick": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        },
        "description": "Mirrors UnitAttackedEvent."
      },
      "BattleEventDtoUnitDiedEventDto": {
        "required": [
          "unitId",
          "position",
          "tick"
        ],
        "properties": {
          "type": {
            "enum": [
              "unitDied"
            ],
            "type": "string"
          },
          "unitId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "position": {
            "$ref": "#/components/schemas/HexCoordDto"
          },
          "tick": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        },
        "description": "Mirrors UnitDiedEvent."
      },
      "BattleEventDtoUnitMovedEventDto": {
        "required": [
          "unitId",
          "from",
          "to",
          "tick"
        ],
        "properties": {
          "type": {
            "enum": [
              "unitMoved"
            ],
            "type": "string"
          },
          "unitId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "from": {
            "$ref": "#/components/schemas/HexCoordDto"
          },
          "to": {
            "$ref": "#/components/schemas/HexCoordDto"
          },
          "tick": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        },
        "description": "Mirrors UnitMovedEvent."
      },
      "BattleEventDtoUnitSpawnedEventDto": {
        "required": [
          "unitId",
          "side",
          "definitionId",
          "position",
          "tick"
        ],
        "properties": {
          "type": {
            "enum": [
              "unitSpawned"
            ],
            "type": "string"
          },
          "unitId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "side": {
            "$ref": "#/components/schemas/SideDto"
          },
          "definitionId": {
            "type": "string"
          },
          "position": {
            "$ref": "#/components/schemas/HexCoordDto"
          },
          "tick": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        },
        "description": "Mirrors UnitSpawnedEvent."
      },
      "BattleOutcomeDto": {
        "required": [
          "winner",
          "terminatingTick",
          "terminationReason"
        ],
        "type": "object",
        "properties": {
          "winner": {
            "$ref": "#/components/schemas/MatchWinnerDto"
          },
          "terminatingTick": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "terminationReason": {
            "$ref": "#/components/schemas/BattleEndingDto"
          }
        }
      },
      "EnemySetupDto": {
        "required": [
          "id",
          "displayName"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable identifier for this enemy setup, unique within the list."
          },
          "displayName": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "required": [
          "message"
        ],
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "HealthResponse": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "HexCoordDto": {
        "required": [
          "row",
          "col"
        ],
        "type": "object",
        "properties": {
          "row": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "col": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        },
        "description": "Mirrors HexCoord."
      },
      "MatchWinnerDto": {
        "type": "integer",
        "description": "Mirrors BattleOutcome, from the player's point of view."
      },
      "MatchupDto": {
        "required": [
          "id",
          "displayName"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable identifier. Pass this back as string? SimulateBattleRequest.MatchupId."
          },
          "displayName": {
            "type": "string"
          }
        }
      },
      "PlayerPlacementDto": {
        "required": [
          "unitId",
          "position"
        ],
        "type": "object",
        "properties": {
          "unitId": {
            "type": "string",
            "description": "An id from `GET /battles/units`."
          },
          "position": {
            "$ref": "#/components/schemas/HexCoordDto"
          }
        }
      },
      "SideDto": {
        "type": "integer",
        "description": "Which army a unit belongs to, as exposed over the wire - a deliberate copy\nof BattleSide, kept separate so the sim's type never\nappears in the OpenAPI contract."
      },
      "SimulateBattleRequest": {
        "type": "object",
        "properties": {
          "matchupId": {
            "type": [
              "null",
              "string"
            ],
            "description": "Valid ids are listed in MatchupCatalog."
          },
          "enemySetupId": {
            "type": [
              "null",
              "string"
            ],
            "description": "Valid ids are listed in EnemySetupCatalog."
          },
          "playerPlacements": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/PlayerPlacementDto"
            },
            "description": "Required alongside string? SimulateBattleRequest.EnemySetupId; ignored alongside string? SimulateBattleRequest.MatchupId."
          },
          "seed": {
            "type": [
              "null",
              "string"
            ],
            "description": "The seed to run the battle with, as a base-10 string — see\nstring SimulateBattleResponse.Seed for why it is a string rather\nthan a JSON number. Null to have the server generate one."
          }
        },
        "description": "The player's side comes from exactly one of two shapes: string? SimulateBattleRequest.MatchupId\nalone (both sides hardcoded), or string? SimulateBattleRequest.EnemySetupId paired with\nIReadOnlyList&lt;PlayerPlacementDto&gt;? SimulateBattleRequest.PlayerPlacements (a hardcoded opponent, a player-built army)."
      },
      "SimulateBattleResponse": {
        "required": [
          "seed",
          "initialSetup",
          "unitDefinitions",
          "events",
          "outcome"
        ],
        "type": "object",
        "properties": {
          "seed": {
            "type": "string",
            "description": "The seed this battle ran with, formatted as a base-10 string rather than\na JSON number: it is a full-range `ulong`, and a JSON\nnumber silently loses precision above 2^53 in a JS/TS client — which\nwould corrupt roughly half of all server-generated seeds and break exact\nre-requesting for them."
          },
          "initialSetup": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StartingUnitDto"
            },
            "description": "In IReadOnlyList&lt;BattleUnit&gt; BattleSetup.Units order."
          },
          "unitDefinitions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UnitDefinitionDto"
            },
            "description": "Only the kinds referenced by IReadOnlyList&lt;StartingUnitDto&gt; SimulateBattleResponse.InitialSetup or IReadOnlyList&lt;BattleEventDto&gt; SimulateBattleResponse.Events, not the full catalog."
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BattleEventDto"
            },
            "description": "Mirrors IReadOnlyList&lt;BattleEvent&gt; BattleSimulation.Events."
          },
          "outcome": {
            "$ref": "#/components/schemas/BattleOutcomeDto"
          }
        }
      },
      "StartingUnitDto": {
        "required": [
          "unitId",
          "side",
          "definitionId",
          "position"
        ],
        "type": "object",
        "properties": {
          "unitId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Unique within this battle only, not globally. See int BattleUnit.Id.",
            "format": "int32"
          },
          "side": {
            "$ref": "#/components/schemas/SideDto"
          },
          "definitionId": {
            "type": "string",
            "description": "Look this up in the response's IReadOnlyList&lt;UnitDefinitionDto&gt; SimulateBattleResponse.UnitDefinitions."
          },
          "position": {
            "$ref": "#/components/schemas/HexCoordDto"
          }
        }
      },
      "UnitDefinitionDto": {
        "required": [
          "id",
          "displayName",
          "maxHp",
          "attackDamage",
          "attackIntervalTicks",
          "movementTicksPerHex",
          "attackRangeHexes",
          "damageVariance"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "maxHp": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "attackDamage": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "attackIntervalTicks": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "movementTicksPerHex": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "attackRangeHexes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "damageVariance": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        },
        "description": "Mirrors UnitDefinition."
      }
    }
  },
  "tags": [
    {
      "name": "Api"
    }
  ]
}